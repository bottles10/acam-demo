<div class="max-w-lg mx-auto mt-20 p-8 bg-white rounded-lg shadow">
  <h1 class="text-2xl font-bold mb-6">Make a Payment</h1>

  <%= form_with url: payments_path, method: :post, local: true, data: { turbo: false } do |f| %>

    <div class="mb-4">
      <%= f.label :email, class: "block text-gray-700" %>
      <%= f.email_field :email, required: true, class: "w-full px-4 py-2 border rounded" %>
    </div>

    <div class="mb-4">
      <%= f.label :tier_id, "Select Student Range", class: "block text-gray-700" %>

      <%= f.collection_select :tier_id,
            PriceTier.order(:min_students),
            :id,
            :display_name,
            { prompt: "Choose a student range" },
            { class: "w-full px-4 py-2 border rounded" } %>
    </div>

    <div class="text-center">
      <%= f.submit "Pay Now", class: "bg-indigo-600 text-white px-6 py-2 rounded hover:bg-indigo-700" %>
    </div>

  <% end %>
</div>
